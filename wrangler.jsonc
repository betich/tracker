{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracker",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-01-01",

  /*
   * One Worker serves both halves: the built Astro pages come straight from
   * `dist`, and only the three API paths below reach the Worker script. Because
   * the pages and the API share an origin, the frontend talks to relative URLs
   * and needs no configured endpoint.
   */
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/state", "/photo", "/api/*", "/t/*"],
    "not_found_handling": "404-page"
  },

  "durable_objects": {
    "bindings": [{ "name": "TRACKER", "class_name": "Tracker" }]
  },

  /*
   * The declarative form, rather than a `migrations` array: it is what lets a
   * fresh deploy — including one made by the Deploy to Cloudflare button on
   * someone else's account — provision the namespace on its own.
   */
  "exports": {
    "Tracker": { "type": "durable-object", "storage": "sqlite" }
  },

  "vars": {
    // Which subject this deployment tracks. Changing it starts a clean slate:
    // a different id is a different Durable Object, with its own timeline.
    "TRACKER_ID": "bundit-live",
    // Extra origins allowed to reach the API. Same-origin is always allowed,
    // so this is only needed when the frontend is hosted somewhere else.
    "ALLOWED_ORIGINS": ""
  },

  "observability": { "enabled": true },

  /*
   * The hosted instance at track.betich.me, which additionally lets anyone
   * create their own tracker. Kept in an environment so the default config
   * above stays deployable by anyone — a self-host owns neither this domain
   * nor any need for the multi-tenant routes.
   *
   *   npx wrangler deploy --env hosted
   */
  "env": {
    "hosted": {
      "name": "tracker",
      "routes": [{ "pattern": "track.betich.me", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "TRACKER", "class_name": "Tracker" },
          { "name": "REGISTRY", "class_name": "Registry" }
        ]
      },
      "exports": {
        "Tracker": { "type": "durable-object", "storage": "sqlite" },
        "Registry": { "type": "durable-object", "storage": "sqlite" }
      },
      "vars": {
        "TRACKER_ID": "bundit-live",
        "ALLOWED_ORIGINS": "",
        // Turns on /new, /t/<slug> and the registry.
        "MULTI_TENANT": "1"
      },
      "observability": { "enabled": true }
    }
  }
}
