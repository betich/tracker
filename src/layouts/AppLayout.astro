---
/**
 * The whole document for an app-like page. Deliberately thin: this is a tool
 * that takes over the viewport, not a page of a website, so there is no
 * analytics, no OG or Twitter card, no RSS or sitemap link — and the only font
 * is the monospace the UI is built in.
 */
import { config } from "@config";
import { GLOW_DARK, GROUND_DARK, INK, INK_CONTRAST } from "@/components/track/palette";

interface Props {
  title: string;
  description?: string;
}

const { title, description = `Where ${config.subject} is.` } = Astro.props;

/*
 * Every page — not just /track — needs the brand shades, so they're set here
 * as custom properties on the root element rather than only inside .track.
 * track.css falls back to these; pages outside .track (tenant "not found",
 * 404) reference them directly.
 */
const brandVars =
  `--brand-ground:${GROUND_DARK};--brand-glow:${GLOW_DARK};` +
  `--brand-ink:${INK};--brand-ink-contrast:${INK_CONTRAST};`;

/*
 * The credit strip below sits under every surface, so the app screens can no
 * longer be a plain 100dvh. `--app-h` is what they take instead: still a
 * definite height — Leaflet needs a measurable box — just shorter by the
 * strip and the home-indicator inset the strip now carries.
 */
const footerVars =
  `--footer-h:2.25rem;--app-h:calc(100dvh - var(--footer-h) - env(safe-area-inset-bottom));`;
---

<html lang="en" style={brandVars + footerVars}>
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover so the safe-area insets the layout relies on resolve. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={GROUND_DARK} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,400;0,500;0,700;1,400&family=Sarabun:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[var(--brand-ground)] font-mono">
    <slot />
    <footer
      class="flex min-h-[var(--footer-h)] items-center justify-center pb-[env(safe-area-inset-bottom)] text-[9px] font-medium uppercase tracking-[0.28em] text-[var(--brand-ink)] opacity-50"
    >
      <span>
        made with love by <a class="underline underline-offset-2" href="https://betich.me">betich.me</a>
        <span aria-hidden="true" class="px-1.5">·</span>
        <a class="underline underline-offset-2" href="https://github.com/betich/tracker">source</a>
      </span>
    </footer>
  </body>
</html>
