# Copy to .env for local development. On Cloudflare these are build-time
# variables, set under the Worker's build configuration — not secrets, since
# anything here is compiled into the pages and visible to every visitor.

# Show the call / LINE buttons at all. Anything but "1" or "true" keeps them
# hidden, and a build with this off does not contain the numbers below.
PUBLIC_CONTACTS=

# Only used when PUBLIC_CONTACTS is on. Either may be left blank to show just
# the other button.
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_LINE=
