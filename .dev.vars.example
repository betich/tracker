# The key /admin expects in its ?key= parameter. Anyone holding it can take the
# tracker and broadcast a position, so treat it like a password.
#
# Generate one with:  openssl rand -hex 20
ADMIN_KEY=

# Unlocks /superadmin, the index of every tracker a shared deployment has
# minted. Leave blank and that page — and the endpoint behind it — stay off.
# Only meaningful with MULTI_TENANT; a self-host has nothing to index.
SUPERADMIN_KEY=
